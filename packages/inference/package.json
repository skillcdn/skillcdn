{
  "name": "@skillcdn/inference",
  "version": "0.3.1",
  "description": "The adapters of the common embeddings and reranking APIs, for the search by meaning of SkillCDN: one call shape for the inference servers a deployment or a person runs, bounded in time and in flight.",
  "license": "FSL-1.1-ALv2",
  "homepage": "https://skillcdn.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillcdn/skillcdn.git",
    "directory": "packages/inference"
  },
  "bugs": "https://github.com/skillcdn/skillcdn/issues",
  "keywords": [
    "skillcdn",
    "embeddings",
    "rerank",
    "agent-skills",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node ../../scripts/pack-license.mjs copy",
    "postpack": "node ../../scripts/pack-license.mjs remove"
  },
  "dependencies": {
    "@skillcdn/core": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
