{
  "name": "@skillcdn/cli",
  "version": "0.3.0",
  "description": "The skillcdn command: check a pack before pushing, read a pack as an agent gets it over MCP, and serve a directory to MCP clients over stdio or HTTP.",
  "license": "FSL-1.1-ALv2",
  "homepage": "https://skillcdn.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skillcdn/skillcdn.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/skillcdn/skillcdn/issues",
  "keywords": [
    "skillcdn",
    "mcp",
    "agent-skills",
    "skills",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "skillcdn": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "node ../../scripts/pack-license.mjs copy",
    "postpack": "node ../../scripts/pack-license.mjs remove"
  },
  "dependencies": {
    "@skillcdn/client": "workspace:^",
    "@skillcdn/core": "workspace:^",
    "@skillcdn/indexer": "workspace:^",
    "@skillcdn/reader": "workspace:^",
    "@skillcdn/serve": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
