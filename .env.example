# Environment contract for the server (apps/server). Copy to `.env` for local development.
#
# Rules:
#   - This file documents every variable the server reads, with safe example values only.
#   - Real values never enter git. `.env` and every other `.env.*` file are ignored.
#   - Add a variable here in the same change that adds it to the config module.
#   - Secrets also accept NAME_FILE=/path/to/file so container secret mounts work.
#   - Hosted deployments inject these from the platform's secret store; nothing is baked into the image.

NODE_ENV=development
LOG_LEVEL=info

# HTTP port for the `api` role.
PORT=8080

# PostgreSQL. Matches deploy/compose.dev.yaml; throwaway local credentials.
DATABASE_URL=postgres://skillcdn:skillcdn-dev-only@127.0.0.1:5432/skillcdn

# Optional. A GitHub token with no scopes raises the API rate limit for public-repo reads.
# GITHUB_TOKEN=
