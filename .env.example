# Environment contract for the server (apps/server). Copy to `.env` for local development.
#
# Rules:
#   - This file documents every variable the server reads, with safe example values only.
#   - Real values never enter git. `.env` and every other `.env.*` file are ignored.
#   - Add a variable here in the same change that adds it to the config module.
#   - Secrets also accept NAME_FILE=/path/to/file so container secret mounts work.
#   - Hosted deployments inject these from the platform's secret store; nothing is baked into the image.
#   - Commented-out lines show the built-in default. An empty value means "not set".

NODE_ENV=development
LOG_LEVEL=info

# HTTP listener of the `api` role, and how long shutdown waits for requests in flight.
# HOST=0.0.0.0
PORT=11188
# SHUTDOWN_GRACE_SECONDS=20

# Behind a reverse proxy or a load balancer (deploy/README.md, "Behind a reverse proxy").
# Keep idle connections open longer than the proxy does, and bound how long one request may take
# to arrive.
# HTTP_KEEP_ALIVE_SECONDS=65
# HTTP_REQUEST_TIMEOUT_SECONDS=60
# One log line per request. Turn it off when the proxy already keeps this log.
# ACCESS_LOG=true
# Peers whose forwarding headers are believed: addresses or CIDR networks, comma-separated.
# Empty means nobody's are, and the client address is the address of the peer.
# TRUSTED_PROXIES=127.0.0.1,::1
# Where a trusted proxy puts the client address and its request id. `x-forwarded-for` is read as
# a chain; any other header as a single address.
# CLIENT_IP_HEADER=x-forwarded-for
# REQUEST_ID_HEADER=x-request-id
# Where a trusted proxy or CDN names the visitor's country (ISO 3166-1 alpha-2, or a subdivision
# such as US-CA): decides whether a page asks before analytics run. Unset, every visitor is asked.
# CLIENT_COUNTRY_HEADER=

# PostgreSQL. Matches deploy/compose.dev.yaml; throwaway local credentials.
DATABASE_URL=postgres://skillcdn:skillcdn-dev-only@127.0.0.1:5432/skillcdn
# DATABASE_POOL_MAX=10

# GitHub. The token is optional and needs no scopes: it only raises the API rate limit for
# public-repo reads. Without one the anonymous limit is low enough to notice while developing.
# GITHUB_API_URL=https://api.github.com
# GITHUB_TOKEN=

# The web UI. WEB_ROOT is a build of apps/web (`pnpm --filter @skillcdn/web run build`, then
# apps/web/dist); the container image brings one and sets this. Unset: no UI, MCP and REST only.
# While developing the UI you do not need it: `pnpm dev:web` serves the UI by itself.
# WEB_ROOT=
# The origin visitors use, for canonical links, the sitemap and the URLs pages show. Unset: the
# origin of each request. Set it for any public deployment.
# PUBLIC_URL=https://skills.example.com

# Packs served from a directory of the deployment, at /local/<owner>/<name> for each directory
# <owner>/<name> under it (deploy/README.md, "Packs from a directory of the deployment"). Unset:
# a local address is a name that is nothing.
# PACKS_DIR=

# Signing in and private repositories (deploy/README.md, "Signing in and private repositories").
# People sign in through a GitHub App; set its four values and AUTH_SECRET together, or none of
# them. It needs PUBLIC_URL and the web UI. Unset: the deployment serves public repositories to
# everyone and knows nobody.
# Where people sign in at the git host. Default: derived from GITHUB_API_URL.
# GITHUB_WEB_URL=https://github.com
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# The app's private key in PEM format and its client secret. GITHUB_APP_PRIVATE_KEY_FILE and
# GITHUB_APP_CLIENT_SECRET_FILE read them from files instead; a key on one line with \n for its
# line breaks is accepted.
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_CLIENT_SECRET=
# The secret of the app's webhook: what GitHub signs its deliveries to PUBLIC_URL/webhooks/gh
# with. Set, the deployment receives the app's events and ends what it remembers when they say
# so; unset, it receives none. At least 32 characters, the same as in the app's settings
# (GITHUB_APP_WEBHOOK_SECRET_FILE reads it from a file).
# GITHUB_APP_WEBHOOK_SECRET=
# What the git host's tokens are encrypted under at rest: at least 32 characters, the same on
# every replica (AUTH_SECRET_FILE reads it from a file). Changing it signs everyone out.
# AUTH_SECRET=
# How long a browser stays signed in without being used, how long an AI app's access token
# lasts, and how long it can renew it without the person.
# SESSION_TTL_DAYS=30
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_DAYS=30
# How long the git host's answer about what a person can see is believed. Someone removed at
# the host keeps access for at most this long; 0 asks on every request.
# PERMISSION_TTL_SECONDS=60

# The admin API: the operator's lists (verified, featured and blocked repositories), the purge of
# a repository, the showcase and its uploads, the pictures of addresses, the deployment's own
# pages and the usage statistics (deploy/README.md, "The admin API"), behind this bearer token at
# /admin/v1. Unset: the API does not exist.
# At least 32 characters; ADMIN_TOKEN_FILE reads it from a file instead.
# ADMIN_TOKEN=

# Proof of ownership for a search console, as the content of its meta tag, and a Google
# Analytics measurement id. Either goes into the head of every page; without them nothing is
# added and pages load nothing from elsewhere. With the id, pages ask the visitor once where
# their region asks first and when they could not be placed, and run analytics at once elsewhere
# with a choice in the footer; a browser that signals Global Privacy Control is never asked.
# What they send names only public repositories (apps/web/README.md, "Analytics").
# GOOGLE_SITE_VERIFICATION=
# GOOGLE_ANALYTICS_ID=
# Where the pages ask first: regions (ISO 3166-1 alpha-2, or US-CA), * for everywhere, none for
# nowhere. Default: the European Economic Area, the United Kingdom and Switzerland.
# ANALYTICS_CONSENT_REGIONS=

# The deployment's own pages and contact, shown in the footer of every page and written into its
# head, each only when set: the terms of the service, its privacy policy, and whom to write to
# about content (takedown requests, reports). A public deployment needs all three; see the
# checklist in deploy/README.md.
# TERMS_URL=
# PRIVACY_URL=
# CONTACT_EMAIL=

# Usage statistics: daily counts per public repository of connections, tool calls, skill loads,
# file reads and distinct clients, and the same totals for the deployment as a whole over every
# repository, naming none, with distinct clients by the app they named. Nothing about who made
# them is stored: a client is a keyed hash of its
# address under the key of the day, and the rows of a day are deleted when it is over. Each
# process writes what it counted this often.
# USAGE_STATS=true
# USAGE_STATS_FLUSH_SECONDS=15
# What client hashes are keyed from, at least 32 characters; USAGE_HASH_SECRET_FILE reads it from a
# file. Unset, each process makes its own at start and replicas count a client more than once.
# USAGE_HASH_SECRET=

# How long facts from the git host are trusted before they are revalidated.
# REPO_TTL_SECONDS=60
# REF_TTL_SECONDS=60

# Indexing: how long a tool call waits for a new commit's index, how many commits one process
# indexes at a time (0: this process indexes nothing and serves only what another process has
# indexed), and how long an indexing claim lasts without being renewed.
# INDEX_WAIT_MS=20000
# INDEX_CONCURRENCY=2
# INDEX_LEASE_SECONDS=120

# Limits on the work one repository may cause. A file over INDEX_MAX_FILE_BYTES is listed and
# readable but not searched; one over READ_MAX_FILE_BYTES is named with where to fetch it instead
# of being served. Over the other limits the index is partial and says so. The `check` role and
# the `skillcdn check` command read these and nothing else.
# INDEX_MAX_TREE_ENTRIES=20000
# INDEX_MAX_FILES=2000
# INDEX_MAX_FILE_BYTES=262144
# INDEX_MAX_TOTAL_BYTES=33554432
# READ_MAX_FILE_BYTES=2097152
# INDEX_MAX_ARCHIVE_BYTES=268435456

# The search by meaning (ADR-0064, ADR-0065): the inference servers a deployment runs beside the
# image, with open-weight models. Unset: the search is by words alone. The embeddings server speaks
# the common embeddings shape (POST <url> with input and model), the reranking server the common
# reranking shape (POST <url> with query and the candidates). Each is read only with its URL, and
# each URL needs its model. With the embeddings server set, the worker role embeds the sections of
# every indexed commit, the api queues the commits it indexes for it (deploy/README.md, "The
# worker"), and a search fuses the sections nearest in meaning with the words' results, reranked
# by the reranking server where there is one (docs/specs/tools.md, "Words and meaning").
# The models of the two profiles, where their files are and how their servers are started:
# deploy/README.md, "The inference server and the model profiles".
# EMBEDDINGS_URL=http://inference:8080/v1/embeddings
# EMBEDDINGS_MODEL=
# Which repositories are embedded: none (the default: nothing new, and what was embedded before is
# searched), public, or all, which sends the text of private repositories to the server as well.
# EMBEDDINGS_SCOPE=none
# Every vector has this many numbers; a longer vector the model answers is cut to them.
# EMBEDDINGS_DIMENSIONS=1024
# The one-line task told to the model in front of a query, never of a document, as the
# instruction-tuned models take it; the models of ADR-0065 lose a few points of retrieval without.
# EMBEDDINGS_QUERY_INSTRUCTION=Given a question about a set of documents, retrieve the sections that answer it
# A bearer token, when the server wants one (EMBEDDINGS_KEY_FILE reads it from a file).
# EMBEDDINGS_KEY=
# How long a call embedding documents may take, and one embedding a query, waiting for a turn
# included; how many calls one process has in flight at once; how sections are packed into one
# call (texts per call, characters per call); what a text is cut to before it is embedded.
# The defaults suit a CPU of eight cores; what two cores take is in deploy/README.md.
# EMBEDDINGS_TIMEOUT_MS=60000
# EMBEDDINGS_QUERY_TIMEOUT_MS=5000
# EMBEDDINGS_CONCURRENCY=2
# EMBEDDINGS_BATCH_TEXTS=16
# EMBEDDINGS_BATCH_CHARS=32000
# EMBEDDINGS_TEXT_CHARS=8000
# The reranking server, optional beside the embeddings server (RERANKER_KEY_FILE reads the key).
# RERANKER_URL=http://inference:8081/v1/rerank
# RERANKER_MODEL=
# RERANKER_KEY=
# RERANKER_TIMEOUT_MS=5000
# RERANKER_CONCURRENCY=2
# How many of the first results of a search the reranker scores before the page is cut.
# RERANKER_CANDIDATES=10

# The search across every public pack this deployment serves, at the root over MCP and at
# GET /api/v1/search: on unless turned off; how long each of its statements over every pack may
# take; how many entries the words, and the meaning, each bring to the fusion of a search.
# HUB_SEARCH=true
# HUB_SEARCH_TIMEOUT_MS=2000
# HUB_SEARCH_CANDIDATES=50
