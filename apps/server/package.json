{
  "name": "@skillcdn/server",
  "version": "0.0.0",
  "private": true,
  "description": "The single deployable. One build, several process roles: api, worker, migrate.",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "node --watch --env-file-if-exists=../../.env --enable-source-maps dist/main.js api",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "eval:search": "node dist/retrieval/report.js",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@napi-rs/canvas": "^1.0.13",
    "@skillcdn/core": "workspace:*",
    "@skillcdn/db": "workspace:*",
    "@skillcdn/github": "workspace:*",
    "@skillcdn/indexer": "workspace:*",
    "@skillcdn/inference": "workspace:*",
    "@skillcdn/reader": "workspace:*",
    "@skillcdn/serve": "workspace:*",
    "hono": "catalog:",
    "pino": "^10.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
